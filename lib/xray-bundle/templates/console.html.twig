<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Live Prompt X-Ray</title>
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Ccircle cx='16' cy='16' r='12' fill='none' stroke='%23d97757' stroke-width='3'/%3E%3Ccircle cx='16' cy='16' r='4' fill='%23e8e6dc'/%3E%3C/svg%3E">
    <link rel="stylesheet" href="{{ asset('xray/console.css') }}">
    <script type="importmap">{{ xray_importmap|json_encode(constant('JSON_UNESCAPED_SLASHES'))|raw }}</script>
    <script type="module" src="{{ asset('xray/console.js') }}"></script>
</head>
<body>
<div class="xr" data-controller="xray-console" data-xray-console-config-value="{{ xray_config|json_encode|e('html_attr') }}"
     data-action="click@window->xray-console#closeMenus keydown@window->xray-console#closeMenus">

    {# The live graph is the background of the whole app. #}
    <div class="stage" aria-label="Live graph of the agent">
        <div class="graph" data-xray-console-target="graph"></div>
        <div class="tooltip" hidden data-xray-console-target="tooltip"></div>
        <div class="welcome" data-xray-console-target="empty">
            <h1>What should the agent do?</h1>
            <p>Start typing: the X-Ray reads your message before you send it. Then watch the agent think.</p>
            <div class="chips" data-xray-console-target="scenarioGrid"></div>
        </div>
    </div>

    <header class="top">
        <div class="brand">
            <svg viewBox="0 0 32 32" aria-hidden="true"><circle cx="16" cy="16" r="12" fill="none" stroke="currentColor" stroke-width="3"/><circle cx="16" cy="16" r="4" fill="var(--accent)"/></svg>
            <span>X-Ray</span>
        </div>
        <div class="metrics" data-xray-console-target="meters" aria-label="Meters"></div>
        <div class="top-actions">
            <span class="status" data-xray-console-target="connection" title="Realtime connection"><span class="dot"></span><span class="sr-only">connecting</span></span>
            <button class="pill" type="button" title="Choose the model" hidden data-xray-console-target="modelButton" data-action="xray-console#openModel">
                <span data-xray-console-target="modeBadge">…</span>
                <svg viewBox="0 0 12 12" aria-hidden="true"><path d="M3 4.5 6 7.5 9 4.5" fill="none" stroke="currentColor" stroke-width="1.5"/></svg>
            </button>
            <div class="menu">
                <button class="icon-btn" type="button" aria-label="Menu" aria-haspopup="true" aria-expanded="false" data-xray-console-target="scenarioButton" data-action="click->xray-console#toggleScenarios:stop">
                    <svg viewBox="0 0 16 16" aria-hidden="true"><circle cx="3" cy="8" r="1.4"/><circle cx="8" cy="8" r="1.4"/><circle cx="13" cy="8" r="1.4"/></svg>
                </button>
                <div class="menu-list" role="menu" hidden data-xray-console-target="scenarioMenu">
                    <button class="menu-item" type="button" role="menuitem" hidden data-xray-console-target="newChat" data-action="xray-console#newChat">New chat</button>
                    <button class="menu-item" type="button" role="menuitem" data-action="xray-console#openDrawer">Recorded runs</button>
                    <button class="menu-item" type="button" role="menuitem" data-action="xray-console#importClick">Import a trace…</button>
                    <div class="menu-sep"></div>
                    <div class="menu-label">Showcase scenarios</div>
                    <div data-xray-console-target="scenarioList"></div>
                </div>
            </div>
        </div>
    </header>

    <div class="toast" role="alert" hidden data-xray-console-target="banner"><span data-xray-console-target="bannerText"></span></div>

    <aside class="side" aria-label="Details">
        <nav class="tabs" role="tablist">
            <button class="tab" role="tab" type="button" data-tab="chat" data-xray-console-target="tab" data-action="xray-console#tab">Chat</button>
            <button class="tab" role="tab" type="button" data-tab="prompt" data-xray-console-target="tab" data-action="xray-console#tab">Context</button>
            <button class="tab" role="tab" type="button" data-tab="tool" data-xray-console-target="tab" data-action="xray-console#tab">Tool</button>
            <button class="tab" role="tab" type="button" data-tab="mcp" data-xray-console-target="tab" data-action="xray-console#tab">MCP</button>
            <button class="tab" role="tab" type="button" data-tab="timeline" data-xray-console-target="tab" data-action="xray-console#tab">Timeline</button>
        </nav>
        <div class="pane" data-xray-console-target="chatPane"><div class="tokens" aria-live="polite" data-xray-console-target="tokens"></div></div>
        <div class="pane" hidden data-xray-console-target="inspectorPane"><div class="insp" data-xray-console-target="inspector"></div></div>
        <div class="pane" hidden data-xray-console-target="timelinePane"><div class="wf" data-xray-console-target="waterfall"></div></div>
    </aside>

    <div class="dock">
        <div class="replay" role="group" aria-label="Replay" hidden data-xray-console-target="replayBar">
            <button class="icon-btn" type="button" title="Replay from the start" data-action="xray-console#restart"><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M4 3v10M13 3 6 8l7 5z"/></svg></button>
            <button class="icon-btn play" type="button" title="Play or pause" disabled data-xray-console-target="playButton" data-action="xray-console#togglePlay">▶</button>
            <input type="range" min="0" max="0" step="1" value="0" disabled aria-label="Position" data-xray-console-target="scrub" data-action="input->xray-console#scrub">
            <span class="time" data-xray-console-target="time">—</span>
            <span class="speed" role="group" aria-label="Replay speed">
                {% for speed in ['1', '2', '4'] %}
                    <button type="button" data-speed="{{ speed }}" aria-pressed="{{ speed == '1' ? 'true' : 'false' }}" data-xray-console-target="speed" data-action="xray-console#setSpeed">{{ speed }}×</button>
                {% endfor %}
            </span>
            <a class="link" href="#" aria-disabled="true" download title="Download this run as a trace file" data-xray-console-target="exportLink">Export</a>
            <span class="sr-only" data-xray-console-target="runLabel"></span>
            <button class="sr-only" type="button" data-action="xray-console#toEnd">Jump to the end</button>
        </div>
        <form class="composer" data-action="submit->xray-console#run">
            <label class="sr-only" for="xr-prompt">Message</label>
            <textarea id="xr-prompt" rows="1" maxlength="2000" placeholder="Message the agent…" data-xray-console-target="prompt"
                      data-action="input->xray-console#typing keydown->xray-console#composeKey"></textarea>
            <button class="send" type="submit" aria-label="Send" data-xray-console-target="runButton">
                <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M8 13V3M3.5 7.5 8 3l4.5 4.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </button>
        </form>
        <p class="hint">Enter to send · Shift+Enter for a new line · the X-Ray updates as you type</p>
    </div>

    <aside class="drawer" aria-label="Recorded runs" inert data-xray-console-target="drawer">
        <div class="drawer-head">Recorded runs
            <span class="spacer"></span>
            <button class="btn" type="button" disabled data-xray-console-target="compareButton" data-action="xray-console#compareRuns">Compare 2</button>
            <button class="icon-btn" type="button" aria-label="Close" data-action="xray-console#closeDrawer">✕</button>
        </div>
        <div class="drawer-body" data-xray-console-target="runsList"></div>
    </aside>

    <div class="drop" hidden data-xray-console-target="drop">Drop an X-Ray trace (.json) to replay it</div>

    <div class="modal" hidden role="dialog" aria-modal="true" aria-label="Run comparison" data-xray-console-target="modal">
        <div class="modal-card">
            <div class="drawer-head">Compare runs <span class="spacer"></span><button class="icon-btn" type="button" aria-label="Close" data-action="xray-console#closeModal">✕</button></div>
            <div data-xray-console-target="modalBody"></div>
        </div>
    </div>

    <div class="modal" hidden role="dialog" aria-modal="true" aria-label="Choose the model" data-xray-console-target="modelModal">
        <form class="modal-card model-card" data-action="submit->xray-console#saveModel">
            <div class="drawer-head">Model <span class="spacer"></span><button class="icon-btn" type="button" aria-label="Close" data-action="xray-console#closeModel">✕</button></div>
            <div class="model-form">
                <p class="muted">Any OpenAI-compatible chat API. The key stays on the server.</p>
                <label>Provider
                    <select data-xray-console-target="modelProvider" data-action="change->xray-console#pickPreset"></select>
                </label>
                <label>Base URL
                    <input type="url" required autocomplete="off" spellcheck="false" placeholder="https://api.example.com/v1" data-xray-console-target="modelBaseUrl">
                </label>
                <label>API key
                    <input type="password" autocomplete="off" spellcheck="false" data-xray-console-target="modelKey">
                </label>
                <label>Model
                    <input type="text" required autocomplete="off" spellcheck="false" list="xr-models" placeholder="model name" data-xray-console-target="modelName">
                    <datalist id="xr-models" data-xray-console-target="modelList"></datalist>
                </label>
                <div class="model-status" role="status" data-xray-console-target="modelStatus"></div>
                <div class="model-actions">
                    <button class="link" type="button" hidden data-xray-console-target="modelDisconnect" data-action="xray-console#disconnectModel">Use the demo model</button>
                    <span class="spacer"></span>
                    <button class="btn" type="button" data-action="xray-console#testModel">Test</button>
                    <button class="btn btn-primary" type="submit">Save</button>
                </div>
            </div>
        </form>
    </div>
</div>
</body>
</html>
