# Copy to .env (next to docker-compose.yml) only if you want to change a default.
# Host port for the app and the Mercure hub
XRAY_HTTP_PORT=8090
# Secret that signs Mercure publisher tokens (local hub only)
MERCURE_JWT_SECRET=xray-local-dev-only-mercure-secret-32b
# demo = scripted model (no API key needed) | ollama | hosted
XRAY_PLATFORM=demo
OLLAMA_HOST_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3:4b
HOSTED_API_KEY=
# X-Ray on/off
XRAY_ENABLED=1
