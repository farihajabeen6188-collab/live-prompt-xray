# Docker Compose settings. Copy to .env (next to docker-compose.yml) only to change a default.
# Host port for the app, the console and the Mercure hub
XRAY_HTTP_PORT=8090
# Signs Mercure publisher tokens (local hub only). Use your own value on a shared machine.
MERCURE_JWT_SECRET=xray-local-dev-only-mercure-secret-32b

# The model is chosen in the console (click the model badge). App settings live in app/.env; override them in
# app/.env.local (not committed), for example:
#   XRAY_ENABLED=0                  # removes X-Ray entirely (clear the cache after changing it)
