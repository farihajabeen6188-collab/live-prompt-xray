{
    "type": "project",
    "license": "MIT",
    "minimum-stability": "beta",
    "prefer-stable": true,
    "require": {
        "php": ">=8.4",
        "ext-ctype": "*",
        "ext-iconv": "*",
        "nyholm/psr7": "^1.8",
        "symfony/ai-agent": "^1.0@beta",
        "symfony/ai-bundle": "^1.0@beta",
        "symfony/ai-generic-platform": "^1.0@beta",
        "symfony/ai-mcp-tool": "^1.0@beta",
        "symfony/ai-ollama-platform": "^1.0@beta",
        "symfony/ai-platform": "^1.0@beta",
        "symfony/ai-store": "^1.0@beta",
        "symfony/asset": "7.4.*",
        "symfony/asset-mapper": "7.4.*",
        "symfony/console": "7.4.*",
        "symfony/dotenv": "7.4.*",
        "symfony/flex": "^2",
        "symfony/framework-bundle": "7.4.*",
        "symfony/http-client": "7.4.*",
        "symfony/mcp-bundle": "^1.0@beta",
        "symfony/mercure-bundle": "^0.3.9",
        "symfony/monolog-bundle": "^4.1",
        "symfony/runtime": "7.4.*",
        "symfony/stimulus-bundle": "^3.7",
        "symfony/twig-bundle": "7.4.*",
        "symfony/ux-turbo": "^3.7",
        "symfony/yaml": "7.4.*",
        "xray/xray-bundle": "@dev"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "phpstan/phpstan": "^2.3",
        "phpstan/phpstan-phpunit": "^2.1",
        "phpstan/phpstan-symfony": "^2.1",
        "phpunit/phpunit": "^13.4",
        "symfony/browser-kit": "7.4.*",
        "symfony/css-selector": "7.4.*"
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true,
            "symfony/flex": true,
            "symfony/runtime": true
        },
        "bump-after-update": true,
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/",
            "XRay\\Tests\\": "../lib/xray-bundle/tests/"
        }
    },
    "replace": {
        "symfony/polyfill-ctype": "*",
        "symfony/polyfill-iconv": "*",
        "symfony/polyfill-php72": "*",
        "symfony/polyfill-php73": "*",
        "symfony/polyfill-php74": "*",
        "symfony/polyfill-php80": "*",
        "symfony/polyfill-php81": "*",
        "symfony/polyfill-php82": "*"
    },
    "scripts": {
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd",
            "importmap:install": "symfony-cmd"
        },
        "post-install-cmd": [
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ]
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "extra": {
        "symfony": {
            "allow-contrib": false,
            "require": "7.4.*"
        }
    },
    "name": "xray/demo-app",
    "description": "Live Prompt X-Ray demo app",
    "repositories": [
        {
            "type": "path",
            "url": "../lib/xray-bundle",
            "options": {
                "symlink": true
            }
        }
    ]
}
